# 비밀 정보 (.env.example은 값 없는 예제라 추적한다)
.env
.env.*
!.env.example
service-account*.json
*credentials*.json
*.pem
*.key

# 가상환경
.venv/
.venv-*/
venv/

# 캐시
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Airflow 런타임 (AIRFLOW_HOME: airflow.cfg 비밀 키, 메타 DB, 로그)
airflow/
logs/
*.log

# 생성 데이터 (README의 "데이터 준비" 절차로 다시 만든다)
data/raw/
data/processed/
data/chunks/
data/embeddings/
data/chroma/*
!data/chroma/.gitkeep

# 백업 파일
*.backup
*.bak
*_backup.py

# OS / 에디터
.DS_Store
