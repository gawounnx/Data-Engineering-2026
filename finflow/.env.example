# FinFlow 환경 변수 예제
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 Git에 올리지 않는다.
#   cp .env.example .env

# --- LLM (src/llm.py) ---
# Google AI Studio에서 발급한 Gemini API 키
GEMINI_API_KEY=
# 비우면 기본값 gemini-flash-latest
GEMINI_MODEL=
# Gemini API 버전. 비우면 v1beta (gemini-flash-latest 별칭은 v1에서 404)
GOOGLE_GENAI_API_VERSION=

# --- 네이버 뉴스 수집 (scripts/collectors/) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 뉴스 검색 범위 (파이프라인과 앱이 같은 값을 읽는다) ---
# 검색용 뉴스 보관 기간(일). 비우면 7. BigQuery·GCS 원본은 지우지 않는다.
NEWS_RETENTION_DAYS=
# 한 번의 파이프라인 실행에서 청킹·임베딩할 최대 기사 수. 비우면 2000
NEWS_MAX_ARTICLES_PER_RUN=

# --- ChromaDB 스냅샷 (src/news_snapshot.py, scripts/vectorstores/) ---
# 앱: 둘 다 비우면 로컬 data/chroma를 사용하고, 하나라도 설정하면 GCS 최신 스냅샷을 내려받는다.
#     (값을 채우는 것만으로 GCS 모드가 되므로, 로컬 모드에서는 둘 다 비워 둔다)
# 스크립트: 비우면 기본 버킷/경로를 사용한다.
#   CHROMA_SNAPSHOT_OBJECT 기본값: finflow/vectorstore/chroma/latest.tar.gz
FINFLOW_BUCKET=
CHROMA_SNAPSHOT_OBJECT=

# --- BigQuery (scripts/processors/chunk_financial_news.py) ---
GCP_PROJECT_ID=
BQ_DATASET_ID=finflow
BQ_LOCATION=asia-northeast3

# --- 기타 ---
# 이벤트 로그 수집 서버 (utils/event_logger.py)
LOG_COLLECTOR_URL=http://127.0.0.1:8080
# scripts/start_streamlit.py 포트
PORT=8080

# GCP 인증은 키 파일 대신 ADC를 권장한다: gcloud auth application-default login

# --- Airflow DAG (dags/naver_news_pipeline_dag.py) ---
# 주의: 이 값들은 .env가 아니라 Airflow scheduler/dag-processor 프로세스의
# 환경 변수로 설정해야 DAG에 적용된다. (README 5장 참고)
# 비우면 DAG 파일 상위 폴더(finflow/)를 루트로 사용
# FINFLOW_PROJECT_ROOT=
# 비우면 <루트>/.venv/bin/python (Windows: .venv\Scripts\python.exe)
# FINFLOW_PYTHON=
